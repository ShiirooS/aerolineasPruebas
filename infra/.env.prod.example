# Ambiente prod. Copiar a infra/.env.prod: cp .env.prod.example .env.prod
# y REEMPLAZAR todos los CHANGE_ME por valores reales y largos.
# Luego: ./env.sh prod up   (añade docker-compose.prod.yml: sin valores por
# defecto para secretos, Redis con contraseña, Keycloak en modo producción).
# El repositorio es público: los valores reales nunca se versionan.

POSTGRES_USER=aeroapp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aeroapp

REDIS_PASSWORD=CHANGE_ME

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

AEROAPP_STACK=aeroapp-prod
POSTGRES_PORT=35432
REDIS_PORT=36379
KEYCLOAK_PORT=38080
