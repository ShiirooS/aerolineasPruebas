# Ambiente dev (local). Copiar a infra/.env.dev: cp .env.dev.example .env.dev
# Luego: ./env.sh dev up

POSTGRES_USER=aeroapp
POSTGRES_PASSWORD=aeroapp
POSTGRES_DB=aeroapp

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Nombre del stack y puertos publicados en el host. Dev conserva los valores
# históricos (contenedores aeroapp-*, puertos estándar).
AEROAPP_STACK=aeroapp
POSTGRES_PORT=5432
REDIS_PORT=6379
KEYCLOAK_PORT=8080
