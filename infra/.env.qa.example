# Ambiente qa. Copiar a infra/.env.qa: cp .env.qa.example .env.qa
# Luego: ./env.sh qa up
# Stack separado de dev (contenedores aeroapp-qa-*, puertos 1xxxx) para que
# ambos puedan correr a la vez en la misma máquina.

POSTGRES_USER=aeroapp
POSTGRES_PASSWORD=aeroapp-qa
POSTGRES_DB=aeroapp

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-qa

AEROAPP_STACK=aeroapp-qa
POSTGRES_PORT=15432
REDIS_PORT=16379
KEYCLOAK_PORT=18080
